# Local runtime config — holds no secrets by design, but is deployment-specific.
config.yaml

# Test instance: Immich's own data, media, captured credentials and scratch state.
# Everything in here is local-only; the sample env file is the single exception.
testinstance/*
!testinstance/example.env

# Python
.venv/
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/
.pytest_cache/
.ruff_cache/

# Deployment secrets — API key and shared webhook token.
.env

# Local compose customisation — see docker-compose.override.example.yaml.
docker-compose.override.yaml

# Claude Code session material (prompts, scratch state); never part of the public repo.
.claude/
