# Local runtime config — holds no secrets by design, but is deployment-specific.
config.yaml

# Test instance: Immich's own data, media, captured credentials and scratch state.
# Everything in here is local-only; the sample env file is the single exception.
testinstance/*
!testinstance/example.env

# Python
.venv/
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/
.pytest_cache/
.ruff_cache/

# Deployment secrets — API key and shared webhook token. The glob, not the bare name:
# .env.bak taken before a `setup --force`, .env.local, .env.prod and any backup made
# before an edit all carry the same key and the same token as .env itself.
.env*
!.env.example

# Written by `setup` when it could not create the workflow itself: carries the shared
# webhook token in clear text. Delete it once the workflow exists.
immich-workflow.json

# Local compose customisation — see docker-compose.override.example.yaml.
docker-compose.override.yaml

# Claude Code session material (prompts, scratch state); never part of the public repo.
.claude/

# Internal working notes: the prompt this repository was built from, and the handover
# written for one specific machine. Both describe a private deployment and a moment that
# has passed, and neither is addressed to anybody who finds this project. They stay on
# disk for whoever wants them; docs/maintainers/launch-checklist.md is the part of that
# material that is genuinely for a reader, and stays tracked.
docs/public-release.md
docs/maintainers/HANDOVER.md
