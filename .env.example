# Environment for docker compose. `immich-compressor setup` writes this file for you;
# copy this template only if you would rather do it by hand.
#
#   cp .env.example .env && chmod 600 .env
#
# .env is gitignored and contains secrets. Everything here can also be set as a plain
# environment variable — compose prefers the environment over the file.

# ---- Required ----------------------------------------------------------------------

# Immich API key: Account Settings -> API Keys. docs/installation.md lists the exact
# permissions to grant, and `immich-compressor setup` names any that are missing.
IMMICH_API_KEY=paste-your-immich-api-key-here

# Shared secret between Immich's workflow webhook and this service. Must equal the
# workflow step's `headerValue`. Generate one with: openssl rand -hex 32
COMPRESSOR_TOKEN=paste-a-long-random-string-here

# ---- Connection --------------------------------------------------------------------

# Reachable from inside the container. With both stacks on the same docker network this
# is the Immich service name, not localhost.
IMMICH_BASE_URL=http://immich-server:2283/api

# The docker network your Immich stack already uses. `docker network ls` shows it; for a
# stock Immich compose project it is immich_default.
IMMICH_NETWORK=immich_default

# ---- Resources ---------------------------------------------------------------------

# Leave Immich at least half the host's cores. The encoder reads this limit from its own
# cgroup and sizes its thread pool to match, so this is the only number to set.
COMPRESSOR_CPUS=2
COMPRESSOR_MEMORY=2g

# ---- GPU (optional) ----------------------------------------------------------------

# Intel and AMD: the container runs as uid 10001 and needs the host's render group to
# open /dev/dri/renderD128. Find it with: getent group render | cut -d: -f3
# RENDER_GID=993

# Load the GPU overlay automatically, so a plain `docker compose up -d` keeps working.
# This list replaces the one compose uses by default, so docker-compose.override.yaml has
# to be named here too — last, because the last file wins. Drop that entry if you do not
# have an override: compose refuses to run at all on a file it cannot find.
# Intel/AMD:
# COMPOSE_FILE=docker-compose.yaml:docker-compose.gpu.yaml:docker-compose.override.yaml
# NVIDIA (needs the NVIDIA Container Toolkit on the host):
# COMPOSE_FILE=docker-compose.yaml:docker-compose.gpu-nvidia.yaml:docker-compose.override.yaml
# NVIDIA_VISIBLE_DEVICES=all
# NVIDIA_GPU_COUNT=1

# ---- Behaviour ---------------------------------------------------------------------
#
# Everything in config.yaml can be overridden here with `__` as the nesting separator.
# These four are the ones people actually change; docs/safety.md explains the stages.
# The defaults are inert on purpose — nothing is uploaded and nothing is deleted.
#
# BEHAVIOR__DRY_RUN=false
# BEHAVIOR__TRASH_ORIGINAL=true
# BEHAVIOR__RETENTION_DAYS=7
# BEHAVIOR__DELETE_MODE=trash
